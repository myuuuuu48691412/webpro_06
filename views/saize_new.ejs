<!Doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title>新規メニュー追加</title>
</head>
<body>
  <h2>新規メニュー追加</h2>

  <form action="/saize/create" method="POST">
    <table>
      <tr><td>ID</td><td><input name="id"></td></tr>
      <tr><td>商品番号</td><td><input name="code"></td></tr>
      <tr><td>商品名</td><td><input name="name"></td></tr>
      <tr><td>ジャンル</td><td><input name="category"></td></tr>
      <tr><td>税込価格</td><td><input name="price"></td></tr>
    </table>

    <input type="submit" value="追加">
  </form>

  <a href="/saize">一覧へ戻る</a>
</body>
</html>
