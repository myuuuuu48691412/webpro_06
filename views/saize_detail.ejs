<!Doctype html>
<html>
<head>
    <meta charset="utf-8">
    <title><%= data.name %></title>
</head>
<body>
    <h2><%= data.name %>の詳細</h2>
    <table>
        <tr><th>項目</th><th>データ</th></tr>
        <tr><td>注文番号</td><td><%= data.code %></td></tr>
        <tr><td>商品名</td><td><%= data.name %></td></tr>
        <tr><td>ジャンル</td><td><%= data.category %></td></tr>
        <tr><td>税込価格</td><td><%= data.price %></td></tr>
    </table>
    <a href="/saize/edit/<%= index %>">編集</a>
    <a href="/saize">商品一覧に戻る</a>
</body>
</html>
