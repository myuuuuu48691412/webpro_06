<!Doctype html>
<html>
<head>
    <meta charset="utf-8">
    <title>ヤングスキニー アルバム一覧</title>
</head>
<body>
    <h2>ヤングスキニー アルバム一覧</h2>
<p><a href="/youngskinny/new">＋ 新規アルバム追加</a></p>
    <table>
        <tr><th>ID</th><th>アルバム名</th></tr>
            <% let number = 0 %>
            <% for( let row of data ) { %>
                <tr><td><%= row.id %></td>
                <td><a href="/youngskinny/<%= number %>"><%= row.title %></a></td></tr>
                <% number += 1 %>
            <% } %>
    </table>
</body>
</html>
