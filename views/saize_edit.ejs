<!Doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title><%= data.name %></title>
</head>
<body>
  <h2><%= data.name %>の編集</h2>

  <form action="/saize/update/<%= index %>" method="POST">
    <table>
      <tr><th>項目</th><th>データ</th></tr>
      <tr><td>ID</td><td><input name="id" value="<%= data.id %>"></td></tr>
      <tr><td>注文番号</td><td><input name="code" value="<%= data.code %>"></td></tr>
      <tr><td>商品名</td><td><input name="name" value="<%= data.name %>"></td></tr>
      <tr><td>ジャンル</td><td><input name="category" value="<%= data.category %>"></td></tr>
      <tr><td>税込価格</td><td><input name="price" value="<%= data.price %>"></td></tr>
    </table>

    <input type="submit" value="登録">
  </form>

  <form action="/saize/delete/<%= index %>" method="POST" style="margin-top:10px;">
  <input type="submit" value="削除"
         onclick="return confirm('本当に削除しますか？');">
</form>

  <a href="/saize">商品一覧に戻る</a>
</body>
</html>

