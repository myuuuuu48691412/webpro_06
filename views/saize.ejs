<!Doctype html>
<html>
<head>
    <meta charset="utf-8">
    <title>サイゼのメニュー</title>
</head>
<body>
    <h2>サイゼのメニュー</h2>
    <table>
        <tr><th>ID</th><th>注文番号</th><th>商品名</th></tr>
            <% let number = 0 %>
            <% for( let row of data ) { %>
                <tr><td><%= row.id %></td>
                <td><%= row.code %></td>
                <td><a href="/saize/<%= number %>"><%= row.name %></a></td></tr>
                <% number += 1 %>
            <% } %>
    </table>
</body>
</html>