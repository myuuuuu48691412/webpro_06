<!Doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title><%= data.name %></title>
</head>
<body>
  <h2><%= data.name %>の編集</h2>

  <form action="/bleague/update/<%= index %>" method="POST">
    <table>
      <tr><th>項目</th><th>データ</th></tr>
      <tr><td>ID</td><td><input name="id" value="<%= data.id %>"></td></tr>
      <tr><td>チーム名</td><td><input name="name" value="<%= data.name %>"></td></tr>
      <tr><td>区分(B1/B2)</td><td><input name="division" value="<%= data.division %>"></td></tr>
      <tr><td>地域</td><td><input name="region" value="<%= data.region %>"></td></tr>
      <tr><td>アリーナ</td><td><input name="arena" value="<%= data.arena %>"></td></tr>
      <tr><td>主要メンバー</td><td><input name="players" value="<%= data.players %>"></td></tr>
      <tr><td>優勝回数</td><td><input name="championships" value="<%= data.championships %>"></td></tr>
      <tr><td>設立年</td><td><input name="founded" value="<%= data.founded %>"></td></tr>

    </table>

    <input type="submit" value="登録">
  </form>

  <form action="/bleague/delete/<%= index %>" method="POST" style="margin-top:10px;">
  <input type="submit" value="削除"
         onclick="return confirm('本当に削除しますか？');">
</form>

  <a href="/bleague">チーム一覧に戻る</a>
</body>
</html>
 